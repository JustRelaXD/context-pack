# ContextPack configuration.
#
# Copy to `.env` and fill in; the server loads it automatically on start.
# A variable already exported in your shell always wins over this file, so
# nothing here can silently shadow your .bashrc.
#
# Every value below is optional. With an empty .env the app runs end to end on
# the rule-based parser with templated sentences and no network calls.

# ---------------------------------------------------------------------------
# Jev / TypeSafe AI — reads the context and parses corrections
# ---------------------------------------------------------------------------
# From https://console.typesafe.ai/settings/keys (early access is waitlisted).
# Without it, contexts are read by the keyword parser instead.
TYPESAFE_API_KEY=

# Optional. Defaults to the canonical https://api.typesafe.ai.
# Point it at a gateway to route the same official SDK elsewhere.
TYPESAFE_BASE_URL=

# Optional. Defaults to "jev-latest".
TYPESAFE_DEFAULT_MODEL=

# ---------------------------------------------------------------------------
# Groq — rewrites the engine's explanation sentences
# ---------------------------------------------------------------------------
# A number appearing in a rewrite that we did not supply gets the rewrite
# discarded, so this can only change wording, never facts.
# Your shell may export this as GROK_API_KEY (with a K); both are accepted.
GROQ_API_KEY=

# Optional. Verified against the live model list by `npm run doctor`.
GROQ_MODEL=openai/gpt-oss-20b

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# "heuristic" forces a fully offline, fully deterministic build that needs no
# keys at all. This is what the test suite uses.
CONTEXTPACK_AGENT=

# Storage adapter: "json" (default, local file) or "memory" (nothing persisted).
# A DynamoDB adapter is the deployment step and is not implemented; asking for
# it fails loudly rather than pretending to work.
CONTEXTPACK_STORE=json

# Where the JSON store writes. Defaults to <repo root>/data/store.json.
CONTEXTPACK_DATA_FILE=

# "off" disables the Open-Meteo lookup, so trips are logged without weather.
CONTEXTPACK_WEATHER=

# Pin weather to fixed coordinates instead of geocoding the destination each
# time. Useful when a destination name isn't a real place.
CONTEXTPACK_LAT=
CONTEXTPACK_LON=

# Set to "1" to enable POST /api/reset, which wipes the store. Off by default:
# an endpoint that deletes everything should not be reachable by accident.
CONTEXTPACK_ALLOW_RESET=

# API port. Defaults to 4000. In production this also serves the built web app.
PORT=
