{
  "name": "contextpack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --noEmit -p tsconfig.json",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w @contextpack/server",
    "dev:web": "npm run dev -w @contextpack/web",
    "build": "npm run build -w @contextpack/web",
    "build:deploy": "node scripts/deploy-build.mjs",
    "start": "npm run start -w @contextpack/server",
    "seed": "npm run seed -w @contextpack/server",
    "doctor": "npm run doctor -w @contextpack/server",
    "setup:aws": "npm run setup:aws -w @contextpack/server",
    "demo": "npm run seed && npm run build && npm run start"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
